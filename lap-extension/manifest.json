{
  "manifest_version": 3,
  "name": "Lap 素材采集器",
  "version": "0.4.0",
  "description": "拖动网页图片，在可展开的文件夹选择器中保存到 Lap；工具栏可批量采集当前页面图片。",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:47821/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Lap 素材采集器",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
